<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مكتبة الحسنين</title>
    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts for Arabic -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Sans+Arabic:wght@300;500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #198754;
            --dark-green: #146c43;
            --soft-bg: #f8fbf9;
        }

        body {
            font-family: 'Noto Sans Arabic', sans-serif;
            background-color: var(--soft-bg);
            color: #333;
        }

        /* Hero Section */
        .hero-wrap { 
            padding: 60px 0 80px 0; 
            background: linear-gradient(135deg, #1e5128 0%, var(--primary-green) 100%);
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .library-title {
            font-family: 'Amiri', serif;
            font-weight: 700;
        }

        /* Modern Search Input */
        .search-wrapper {
            max-width: 600px;
            margin: 0 auto;
        }

        .search-input {
            border-radius: 50px;
            padding: 15px 25px 15px 55px; /* Adjust for icon */
            border: none;
            height: 60px;
            font-size: 1.1rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
        }

        .search-icon {
            position: absolute;
            top: 50%;
            left: 20px;
            transform: translateY(-50%);
            color: var(--primary-green);
            font-size: 1.3rem;
        }

        /* Glass Categories */
        .bg-glass {
            background: rgba(255, 255, 255, 0.15) !important;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            transition: all 0.3s ease;
            border-radius: 12px;
        }

        .category-card:hover {
            background: #ffffff !important;
            transform: translateY(-5px);
        }

        .category-card:hover .cat-name {
            color: var(--primary-green) !important;
        }

        /* Book Cards Styling */
        .book-card {
            border-radius: 20px;
            transition: all 0.3s ease;
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .book-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(25, 135, 84, 0.12) !important;
        }

        .book-title {
            color: #dc3545; /* Your requested color */
            font-family: 'Amiri', serif;
            font-weight: 700;
            font-size: 1.3rem;
            line-height: 1.4;
        }

        .detail-text {
            font-size: 0.95rem;
            color: #555;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-vol {
            background-color: #f1f3f5;
            color: #495057;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            border: 1px solid #dee2e6;
        }

        .hidden { display: none; }

        @media (max-width: 768px) {
            .hero-wrap { padding: 40px 0 60px 0; border-radius: 0 0 25px 25px; }
            .display-3 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>

<header class="hero-wrap text-white text-center">
    <div class="container">
        <h1 class="display-3 library-title mb-2">مكتبة الحسنين</h1>
        <p class="lead opacity-75 mb-4">أهلاً بكم في الفهرس الرقمي</p>

        <!-- Search Bar -->
        <div class="search-wrapper position-relative mb-5">
            <input type="text" id="userSearch" class="form-control shadow-lg search-input text-end" 
                   placeholder="ابحث عن كتاب، مؤلف، أو تصنيف..." dir="rtl">
            <i class="fas fa-search search-icon"></i>
        </div>

        <!-- Categories -->
        <div class="row g-2 justify-content-center row-cols-3 row-cols-md-6 px-2">
            {{#each categories}}
            <div class="col">
                <a href="{{this.link}}" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm category-card bg-glass py-2">
                        <div class="small fw-bold text-white text-center px-1 cat-name">
                            {{this.name}}
                        </div>
                    </div>
                </a>
            </div>
            {{/each}}
        </div>
    </div>
</header>

<main class="py-5" dir="rtl">
    <div class="container">
        <!-- Result Info -->
        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <h5 class="fw-bold mb-0">قائمة الكتب</h5>
            <span class="text-muted small">إجمالي الكتب: {{books.length}}</span>
        </div>

        <!-- Books Grid -->
        <div class="row" id="bookContainer">
            {{#each books}}
            <div class="col-12 col-md-6 mb-4 book-item">
                <div class="card h-100 shadow-sm book-card border-0">
                    <div class="card-body p-4">
                        <!-- Line 1: Book Name -->
                        <div class="mb-3 border-bottom pb-2">
                            <h5 class="book-title mb-0">{{this.book_name}}</h5>
                        </div>

                        <!-- Line 2: All Other Details -->
                        <div class="row gy-2">
                            <div class="col-12 detail-text">
                                <i class="fas fa-user-edit text-success"></i>
                                <span><strong>المؤلف:</strong> {{this.author}}</span>
                            </div>
                            <div class="col-12 detail-text">
                                <i class="fas fa-layer-group text-success"></i>
                                <span><strong>التصنيف:</strong> {{this.category}}</span>
                            </div>
                            <div class="col-12 d-flex align-items-center mt-3">
                                <span class="badge-vol me-3">الجزء: {{this.vol}}</span>
                                <span class="text-muted small"><i class="far fa-building me-1"></i> {{this.publishers}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</main>

<script>
    // Search Functionality
    document.getElementById('userSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const bookItems = document.querySelectorAll('.book-item');

        bookItems.forEach(item => {
            const content = item.textContent.toLowerCase();
            if (content.includes(searchTerm)) {
                item.classList.remove('hidden');
            } else {
                item.classList.add('hidden');
            }
        });
    });
</script>

</body>
</html>